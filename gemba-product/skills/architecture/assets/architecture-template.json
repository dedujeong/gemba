{
  "product": {
    "name": "<Product name, as the Product Brief writes it>"
  },
  "context": {
    "description": "<Who uses the product and which systems it talks to>",
    "actors": ["<Role that uses it>", "<Another role>"],
    "externals": [
      {"name": "<System somebody else runs>"}
    ],
    "relations": [
      {"from": "<Role>", "to": "<Product name>", "label": "<what that role does there>"},
      {"from": "<Product name>", "to": "<System>", "label": "<what flows to it>"}
    ]
  },
  "containers": {
    "description": "<What runs where and what each part is in charge of>",
    "actors": ["<Role that reaches a piece directly>"],
    "boundaries": [
      {
        "name": "<Where these pieces run, with its plan>",
        "containers": [
          {"name": "<Piece>"},
          {"name": "<Store>", "shape": "database"}
        ]
      }
    ],
    "externals": [
      {"name": "<System somebody else runs>"}
    ],
    "relations": [
      {"from": "<Piece>", "to": "<Store>", "label": "<what flows between them>"}
    ]
  },
  "data_model": {
    "description": "<What the product keeps and how it relates>",
    "entities": [
      {"name": "<Entity named by a story>", "fields": ["<main field>", "<another field>"]}
    ],
    "relations": [
      {"from": "<Entity>", "to": "<Other entity>", "label": "<Verb>", "cardinality": "1:N"}
    ]
  },
  "states": [
    {
      "entity": "<Entity of the data model that changes state>",
      "description": "<How it changes>",
      "initial": {"state": "<First state>", "event": "<What creates it>"},
      "states": ["<First state>", "<Another state>"],
      "transitions": [
        {"from": "<First state>", "to": "<Another state>", "event": "<What moves it>"}
      ]
    }
  ]
}
